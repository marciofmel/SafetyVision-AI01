generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  senhaHash     String
  cargo         String    @default("Tecnico")
  foto          String?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  inspecoes     Inspecao[]
  empresas      Empresa[]
  setores       Setor[]
  colaboradores Colaborador[]
  checklists    ChecklistTemplate[]
  epis          Epi[]
  treinamentos  Treinamento[]
  incidentes    Incidente[]
  laudos        Laudo[]
}

model Empresa {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  nome                String
  cnpj                String?
  endereco            String?
  telefone            String?
  email               String?
  bairro              String?
  cidade              String?
  estado              String?
  cep                 String?
  naturezaJuridica    String?
  porte               String?
  dataAbertura        String?
  capitalSocial       String?
  situacao            String?
  atividadePrincipal  String?
  atividadeSecundaria String?
  simplesNacional     Boolean?
  empresaMEI          Boolean?
  socios              String?
  site                String?
  observacoes         String?
  ativo               Boolean   @default(true)
  createdAt           DateTime  @default(now())
  setores             Setor[]
  inspecoes           Inspecao[]
  colaboradores       Colaborador[]
  epis                Epi[]
  treinamentos        Treinamento[]
  incidentes          Incidente[]
  laudos              Laudo[]
}

model Setor {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  nome      String
  descricao String?
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  inspecoes Inspecao[]
  collabors Colaborador[]
  epis      Epi[]
  incidentes Incidente[]
}

model Colaborador {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  nome            String
  cpf             String?
  rg              String?
  cargo           String?
  setorId         String?
  setor           Setor?    @relation(fields: [setorId], references: [id])
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  telefone        String?
  email           String?
  dataNascimento  String?
  admissao        String?
  matricula       String?
  aso             String?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  episEntregas    EpiEntrega[]
  treinamentos    TreinamentoParticipacao[]
}

model Inspecao {
  id              String    @id @default(cuid())
  empresaId       String
  setorId         String
  usuarioId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  setor           Setor     @relation(fields: [setorId], references: [id])
  usuario         User      @relation(fields: [usuarioId], references: [id])
  status          String    @default("em_andamento")
  dataInicio      DateTime  @default(now())
  dataFim         DateTime?
  totalFotos      Int       @default(0)
  totalVideos     Int       @default(0)
  notaConformidade Float?
  observacoes     String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  midias          Midia[]
  riscos          Risco[]
  epiViolacoes    EpiViolacao[]
  checklistRespostas ChecklistResposta[]
  laudos          Laudo[]
}

model Midia {
  id         String    @id @default(cuid())
  inspecaoId String
  inspecao   Inspecao  @relation(fields: [inspecaoId], references: [id])
  tipo       String
  url        String
  nome       String
  descricao  String?
  createdAt  DateTime  @default(now())
}

model Risco {
  id              String    @id @default(cuid())
  inspecaoId      String
  inspecao        Inspecao  @relation(fields: [inspecaoId], references: [id])
  categoria       String
  descricao       String
  localIdentificado String
  imagemUrl       String?
  confianca       Float
  gravidade       String
  consequencias   String
  nrsRelacionadas String?
  medidasPreventivas String
  medidasCorretivas  String
  prioridade      String
  status          String    @default("aberto")
  createdAt       DateTime  @default(now())
}

model EpiViolacao {
  id         String    @id @default(cuid())
  inspecaoId String
  inspecao   Inspecao  @relation(fields: [inspecaoId], references: [id])
  epiNome    String
  status     String
  confianca  Float
  descricao  String?
  imagemUrl  String?
  createdAt  DateTime  @default(now())
}

model ChecklistTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  nome        String
  descricao   String?
  nr          String
  itens       ChecklistItem[]
  respostas   ChecklistResposta[]
  createdAt   DateTime @default(now())
}

model ChecklistItem {
  id          String   @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  texto       String
  obrigatorio Boolean  @default(true)
  ordem       Int      @default(0)
  respostas   ChecklistResposta[]
}

model ChecklistResposta {
  id          String   @id @default(cuid())
  inspecaoId  String
  inspecao    Inspecao @relation(fields: [inspecaoId], references: [id], onDelete: Cascade)
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id])
  itemId      String
  item        ChecklistItem @relation(fields: [itemId], references: [id])
  conformidade String
  observacao  String?
  createdAt   DateTime @default(now())
}

model Epi {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  nome            String
  ca              String?
  fabricante      String?
  validadeCa      DateTime?
  dataCompra      DateTime?
  vidaUtilMeses   Int?
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  setorId         String?
  setor           Setor?    @relation(fields: [setorId], references: [id])
  status          String    @default("ativo")
  observacoes     String?
  createdAt       DateTime  @default(now())
  entregas        EpiEntrega[]
}

model EpiEntrega {
  id         String    @id @default(cuid())
  epiId      String
  epi        Epi       @relation(fields: [epiId], references: [id], onDelete: Cascade)
  colaboradorId String
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id])
  dataEntrega DateTime  @default(now())
  dataDevolucao DateTime?
  assinatura  String?
  observacao  String?
}

model Treinamento {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  nome            String
  nr              String?
  descricao       String?
  cargaHoraria    Int?
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  dataInicio      DateTime
  dataFim         DateTime?
  local           String?
  instrutor       String?
  status          String    @default("agendado")
  createdAt       DateTime  @default(now())
  participacoes   TreinamentoParticipacao[]
}

model TreinamentoParticipacao {
  id              String    @id @default(cuid())
  treinamentoId   String
  treinamento     Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  colaboradorId   String
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id])
  status          String    @default("pendente")
  dataConclusao   DateTime?
  certificado     String?
  nota            Float?
  observacao      String?
}

model Incidente {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  setorId         String?
  setor           Setor?    @relation(fields: [setorId], references: [id])
  dataIncidente   DateTime
  tipo            String
  gravidade       String
  descricao       String
  localIncidente  String?
  colaboradoresEnvolvidos String?
  testemunhas     String?
  causas          String?
  acoesCorretivas String?
  acoesPreventivas String?
  danos           String?
  catNumero       String?
  catData         DateTime?
  status          String    @default("aberto")
  createdAt       DateTime  @default(now())
}

model Laudo {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  inspecaoId      String?
  inspecao        Inspecao? @relation(fields: [inspecaoId], references: [id])
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  titulo          String
  nr              String?
  tipo            String    @default("inspecao")
  conteudo        String?
  dataEmissao     DateTime  @default(now())
  responsavel     String?
  aprovado        Boolean   @default(false)
  arquivoUrl      String?
  createdAt       DateTime  @default(now())
}
